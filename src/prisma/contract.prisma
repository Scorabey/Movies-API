// use prisma-8
model Movie {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  img         String
  categories  Category[]
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model MovieCategory {
  movieId Int
  categoryId Int
  movie Movie @relation(fields: [movieId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([movieId, categoryId])
}
